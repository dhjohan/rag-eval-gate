# Copy to .env and fill in only the providers you actually use.
# .env is git-ignored; never commit real keys.

# NVIDIA NIM (build.nvidia.com) - 40 RPM / 10,000 RPD free
NVIDIA_API_KEY=

# Google AI Studio - free tier, per-project limits shown in AI Studio
GEMINI_API_KEY=

# Cloudflare Workers AI - 10,000 Neurons/day free
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenRouter - free models, 50 requests/day under 10 credits
OPENROUTER_API_KEY=

# Jina AI - embeddings + reranking, free tier
JINA_API_KEY=

# Optional overrides
RAG_EVAL_CACHE_PATH=.cache/rag_eval.sqlite3
RAG_EVAL_PROVIDERS_CONFIG=configs/providers.yaml
